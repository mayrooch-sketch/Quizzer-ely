# Os arquivos de /assets têm o hash do conteúdo no nome: mudou o conteúdo,
# mudou o nome. Podem ser guardados para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Estes três decidem qual versão do app o aparelho vê. Guardar é o que faz
# um deploy novo demorar dias para chegar em quem já usou.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
